# Shown in the page title, hero text and footer
EVENT_NAME="Treasure Hunt"
SECRET_KEY=change-me

# Public URL that QR codes / answer links point to (must end with /treasure-hunt/)
BASE_URL=http://127.0.0.1:8010/treasure-hunt/
PORT=8010

# Salt used by sync_clues.py to derive unguessable clue hashes — change per event
HASH_SALT=change-me

# Optional: only needed if you pull clues from Airtable with sync_clues.py
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_TOKEN=
